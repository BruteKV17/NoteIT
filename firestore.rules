rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Authenticated users can read and write to their own user document and any subcollections beneath it
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Authenticated users can read and write to all nested subcollections
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

