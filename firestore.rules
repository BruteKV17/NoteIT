rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents & subcollections
    match /users/{userId} {
      allow read, write: if true;
      
      // All nested subcollections under user (subjects, lectures, notes, folders, sources, etc.)
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // Pending shared lectures staged for peer students
    match /pendingShares/{shareId} {
      allow read, write: if true;
    }

    // Feedback & support ticket submissions
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }

    // Student Doubts submitted to Faculty
    match /doubts/{doubtId} {
      allow read, write, create, update, delete: if true;
    }

    // Teacher subject assignments
    match /teacherAssignments/{assignmentId} {
      allow read, write: if true;
    }

    // Quiz attempts & performance records
    match /quizAttempts/{attemptId} {
      allow read, write: if true;
    }

    // Global fallback rule for all NoteIT users across any collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
